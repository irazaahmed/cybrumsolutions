// Prisma schema for Cybrum Solutions.
//
// Prisma was introduced for the Skills Library. The pre-existing `leads`
// table (written to by src/lib/leads.ts via the raw Neon SQL driver) is also
// modelled here as `Lead` so Prisma is aware of it and never drops it during
// `db push`. Runtime lead capture still uses the raw SQL in leads.ts; this
// model just keeps the table under Prisma's management.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id           BigInt   @id @default(autoincrement())
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  name         String
  email        String?
  phone        String?
  businessType String?  @map("business_type")
  need         String
  budget       String?
  source       String

  @@index([createdAt(sort: Desc)], map: "leads_created_at_idx")
  @@map("leads")
}

model Skill {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  category      String
  tags          String[]
  description   String   @db.Text
  content       String   @db.Text
  usageNotes    String   @db.Text
  downloadCount Int      @default(0)
  published     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([published])
}

// --- Student enrollment portal (course: "How to earn in the AI era") ---
// Manual proof-based payment flow, mirroring cs-chatbot's tenant/payment
// pattern (D:\Code\Portfolio-Project\cs-chatbot) — the student-facing
// equivalent of a Tenant, one Course per offering, one Enrollment linking
// a Student to a Course, one Payment per submitted proof.

model Student {
  id             String       @id @default(cuid())
  name           String
  email          String       @unique
  // Null for accounts created via Google sign-in (no password set) — the
  // Credentials provider's authorize() rejects login for those, they must
  // use the Google button instead.
  passwordHash   String?
  phone          String?
  avatarFilename String?
  createdAt      DateTime     @default(now())

  enrollments  Enrollment[]
  payments     Payment[]
}

model Course {
  id            String       @id @default(cuid())
  slug          String       @unique
  title         String
  description   String       @db.Text
  priceAmount   Int
  priceCurrency String       @default("PKR")
  published     Boolean      @default(true)
  createdAt     DateTime     @default(now())

  enrollments   Enrollment[]
  payments      Payment[]
  modules       Module[]
}

// Gives a course real curriculum structure (CS Academy) even before Ahmed
// has recorded real lessons — modules/lessons render as an outline with
// placeholder summaries rather than the site showing nothing at all.
model Module {
  id       String   @id @default(cuid())
  courseId String
  title    String
  order    Int

  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]

  @@index([courseId])
}

model Lesson {
  id       String  @id @default(cuid())
  moduleId String
  title    String
  order    Int
  summary  String? @db.Text

  module   Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
}

model Enrollment {
  id           String    @id @default(cuid())
  studentId    String
  courseId     String
  status       String    @default("pending_payment") // pending_payment | pending_review | active | rejected
  createdAt    DateTime  @default(now())
  activatedAt  DateTime?

  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@unique([studentId, courseId])
  @@index([status])
}

model Payment {
  id             String    @id @default(cuid())
  enrollmentId   String
  studentId      String
  courseId       String
  amount         Int
  method         String // jazzcash | easypaisa | bank
  senderName     String
  transactionRef String
  proofFilename  String
  status         String    @default("submitted") // submitted | approved | rejected
  submittedAt    DateTime  @default(now())
  reviewedAt     DateTime?

  enrollment     Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  student        Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course         Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([status])
}
